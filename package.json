{
  "name": "tianai-portfolio",
  "version": "1.0.0",
  "description": "Vittoria — AI Researcher & Technical Leader Personal Website & Blog CMS on Cloudflare Workers",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
